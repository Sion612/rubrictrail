{
  "name": "rubrictrail",
  "version": "0.8.1",
  "private": true,
  "description": "A local-first, evidence-linked assignment planner that turns briefs and rubrics into an auditable plan.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sion612/rubrictrail.git"
  },
  "homepage": "https://sion612.github.io/rubrictrail/",
  "bugs": {
    "url": "https://github.com/Sion612/rubrictrail/issues"
  },
  "keywords": [
    "education",
    "rubric",
    "assignment-planner",
    "local-first",
    "open-source"
  ],
  "scripts": {
    "prepare:ocr": "node scripts/prepare-ocr-assets.mjs all",
    "predev": "node scripts/prepare-ocr-assets.mjs root",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-ocr-assets.mjs root",
    "build": "next build",
    "prebuild:demo": "node scripts/prepare-ocr-assets.mjs demo",
    "build:demo": "next build demo",
    "build:workspace-harness": "next build tests/workspace-dashboard-harness",
    "audit:demo": "node scripts/audit-static-demo.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/ocr-asset-audit.test.mjs",
    "test:ocr-assets": "node --test scripts/ocr-asset-audit.test.mjs",
    "test:deployment-smoke": "node --test scripts/deployment-smoke.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:demo": "playwright test --config=playwright.demo.config.ts",
    "test:e2e:workspace": "playwright test --config=playwright.workspace.config.ts",
    "capture:screenshots": "node scripts/capture-screenshots.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "lucide-react": "1.25.0",
    "mammoth": "1.12.0",
    "next": "16.3.0",
    "openai": "6.48.0",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.7",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.9.0"
}
