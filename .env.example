# RubricTrail is fully usable as a local-first app without this file.
# Live mode is deliberately disabled by default.
OPENAI_LIVE_ENABLED=false
OPENAI_API_KEY=
OPENAI_LIVE_TOKEN=
OPENAI_MODEL=gpt-5.6
OPENAI_REQUEST_TIMEOUT_MS=45000

# If self-hosting the experimental Live routes, OPENAI_LIVE_TOKEN must be a
# random secret of at least 32 characters and requests must send it as a Bearer
# token. Do not enable Live routes on a public demo without rate and budget caps.
# The current UI intentionally exposes no Live-mode control.
