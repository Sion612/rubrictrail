{
  "name": "rubrictrail",
  "version": "0.4.0",
  "private": true,
  "description": "A local-first, evidence-linked assignment planner that turns briefs and rubrics into an auditable plan.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sion612/rubrictrail.git"
  },
  "homepage": "https://github.com/Sion612/rubrictrail#readme",
  "bugs": {
    "url": "https://github.com/Sion612/rubrictrail/issues"
  },
  "keywords": [
    "education",
    "rubric",
    "assignment-planner",
    "local-first",
    "open-source"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "capture:screenshots": "node scripts/capture-screenshots.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "lucide-react": "1.25.0",
    "mammoth": "1.12.0",
    "next": "16.3.0",
    "openai": "6.48.0",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.9.0"
}
